{
  "openapi": "3.0.0",
  "info": {
    "title": "CANsub REST API",
    "version": "05.00",
    "description": "CANsub REST API for configuration and monitoring."
  },
  "servers": [
    {
      "url": "https://{device_id}-usb.local",
      "description": "USB connection.",
      "variables": {
        "device_id": {
          "default": "aabbccdd",
          "description": "8-digit hexadecimal device ID shown on the device display & label (e.g. aabbccdd)."
        }
      }
    },
    {
      "url": "https://{device_id}-eth.local",
      "description": "Ethernet connection.",
      "variables": {
        "device_id": {
          "default": "aabbccdd",
          "description": "8-digit hexadecimal device ID shown on the device display & label (e.g. aabbccdd)."
        }
      }
    }
  ],
  "security": [],
  "paths": {
    "/api/version": {
      "get": {
        "summary": "Get API version",
        "description": "Returns the current version of the REST API.",
        "responses": {
          "200": {
            "description": "API Version.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "01.23"
                }
              }
            }
          }
        }
      }
    },

    "/api/info": {
      "get": {
        "summary": "Get device information",
        "description": "Returns general device information.",
        "responses": {
          "200": {
            "description": "Device information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Device ID as an 8-digit hexadecimal value."
                    },
                    "hw_ver": {
                      "type": "string",
                      "description": "Hardware version with format \"xx.yy\"."
                    },
                    "fw_ver": {
                      "type": "string",
                      "description": "Firmware version with format \"xx.yy.zz\"."
                    },
                    "mac": {
                      "type": "string",
                      "description": "MAC address as a 12-digit hexadecimal value."
                    },
                    "usb": {
                      "type": "string",
                      "description": "USB VID & PID with format \"XXXX&YYYY\"."
                    }
                  },
                  "required": ["id", "hw_ver", "fw_ver", "mac", "usb"],
                  "example": {
                    "id": "aabbccdd",
                    "hw_ver": "01.02",
                    "fw_ver": "01.02.03",
                    "mac": "001122334455",
                    "usb": "04D8&E487"
                  }
                }
              }
            }
          }
        }
      }
    },

    "/api/time": {
      "get": {
        "summary": "Get device time",
        "description": "Returns the current device time and the clock rate correction currently applied.",
        "responses": {
          "200": {
            "description": "Current device time and rate correction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/time"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Set device time",
        "description": "Sets the device time and the clock rate correction. Overrides and disables time synchronization for the rest of the power cycle.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/time"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device time set successfully."
          },
          "400": {
            "description": "Bad request (invalid object, unsupported time format, or time or rate outside the supported range)."
          }
        }
      }
    },

    "/api/time/ptp": {
      "get": {
        "summary": "Get PTP status",
        "description": "Returns the status of the PTP (IEEE 1588) time synchronization.",
        "responses": {
          "200": {
            "description": "PTP status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "master": {
                      "type": "string",
                      "nullable": true,
                      "description": "Clock identity of the PTP master being followed, or null when no master has been detected or synchronization is disabled."
                    },
                    "state": {
                      "type": "string",
                      "enum": ["disabled", "idle", "initializing", "tracking"],
                      "description": "Synchronization state. Disabled: Permanently disabled. Idle: No synchronization information is being received. Initializing: Preparing for tracking. Tracking: Tracking external time."
                    },
                    "offset_ns": {
                      "type": "integer",
                      "description": "Clock error at the latest measurement, in nanoseconds (positive when the device clock is ahead of the master). Zero when not in the tracking state."
                    }
                  },
                  "required": ["master", "state", "offset_ns"],
                  "example": {
                    "master": "a1a2a3a4a5a6a7a8",
                    "state": "tracking",
                    "offset_ns": -1500
                  }
                }
              }
            }
          }
        }
      }
    },

    "/api/reboot": {
      "post": {
        "summary": "Reboot device",
        "description": "Reboots the device. All active WebSocket connections are closed.",
        "responses": {
          "202": {
            "description": "Reboot initiated."
          }
        }
      }
    },

    "/api/client-cert": {
      "get": {
        "summary": "Get client certificate identifier",
        "description": "Returns the SHA-256 fingerprint of the DER-encoded client certificate currently loaded as the trust anchor for TLS mutual authentication.",
        "responses": {
          "200": {
            "description": "SHA-256 fingerprint of the loaded client certificate as a 64-digit hexadecimal value.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64,
                  "example": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
                }
              }
            }
          },
          "404": {
            "description": "No client certificate loaded (mutual authentication disabled)."
          }
        }
      },
      "put": {
        "summary": "Upload client certificate",
        "description": "Uploads the client public certificate (PEM format) used as the trust anchor for TLS mutual authentication, replacing any existing certificate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-pem-file": {
              "schema": {
                "type": "string",
                "example": "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificate stored. Mutual authentication enabled."
          },
          "400": {
            "description": "Bad request (not a valid X.509 certificate)."
          },
          "413": {
            "description": "Payload too large."
          }
        }
      },
      "delete": {
        "summary": "Remove client certificate",
        "description": "Removes the stored client certificate, disabling TLS mutual authentication.",
        "responses": {
          "200": {
            "description": "Certificate removed. Mutual authentication disabled."
          },
          "404": {
            "description": "No client certificate loaded."
          }
        }
      }
    },

    "/api/can": {
      "get": {
        "summary": "List available CAN channels",
        "description": "Returns a list of supported CAN channels.",
        "responses": {
          "200": {
            "description": "List of CAN channels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "example": [1, 2, 3, 4]
                }
              }
            }
          }
        }
      }
    },

    "/api/can/{channel}": {
      "get": {
        "summary": "Get status of CAN channel",
        "description": "Returns the current status of the CAN channel.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CAN channel status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/status"
                }
              }
            }
          },
          "404": {
            "description": "CAN channel not found."
          }
        }
      }
    },

    "/api/can/{channel}/ws": {
      "delete": {
        "summary": "Abort CAN channel WebSocket connection",
        "description": "Aborts the channel WebSocket connection. Queued data is discarded (not transmitted on the CAN bus), allowing the connection to close even when the bus cannot transmit the queued data.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "WebSocket connection abort requested."
          },
          "404": {
            "description": "No active WebSocket connection on the channel."
          }
        }
      }
    },

    "/api/can/{channel}/phy": {
      "get": {
        "summary": "Get CAN channel PHY configuration",
        "description": "Returns CAN channel PHY configuration.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PHY configuration returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/phy"
                }
              }
            }
          },
          "404": {
            "description": "CAN channel not found."
          }
        }
      },
      "put": {
        "summary": "Set CAN channel PHY configuration",
        "description": "Sets CAN channel PHY configuration.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/phy"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PHY configuration applied."
          },
          "400": {
            "description": "Bad request (invalid JSON)."
          },
          "404": {
            "description": "CAN channel not found."
          }
        }
      }
    },

    "/api/can/{channel}/filter": {
      "get": {
        "summary": "List active receive filters",
        "description": "Returns a list of IDs for all currently active receive filters.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of filter IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "CAN channel not found."
          }
        }
      },
      "post": {
        "summary": "Create new receive filter",
        "description": "Creates a new receive filter.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/filter"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Filter created successfully.",
            "headers": {
              "Location": {
                "description": "URI of the newly created filter.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid JSON)."
          },
          "404": {
            "description": "CAN channel not found."
          },
          "503": {
            "description": "Service unavailable (e.g., no more space for filters)."
          }
        }
      }
    },

    "/api/can/{channel}/filter/{filter_id}": {
      "get": {
        "summary": "Get filter",
        "description": "Returns receive filter details by ID.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filter details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/filter"
                }
              }
            }
          },
          "404": {
            "description": "Filter not found."
          }
        }
      },
      "delete": {
        "summary": "Delete filter",
        "description": "Removes a receive filter by ID.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filter deleted successfully."
          },
          "404": {
            "description": "Filter not found."
          }
        }
      }
    },

    "/api/can/{channel}/transmit": {
      "get": {
        "summary": "List transmit sequences",
        "description": "Returns a list of IDs for existing transmit sequences.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transmit IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "CAN channel not found."
          }
        }
      },
      "post": {
        "summary": "Create new transmit sequence",
        "description": "Creates a new transmit sequence.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/transmit_sequence"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transmit sequence created.",
            "headers": {
              "Location": {
                "description": "URI of the newly created transmit sequence.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid JSON)."
          },
          "404": {
            "description": "CAN channel not found."
          },
          "503": {
            "description": "Service unavailable (e.g., no more space for transmit sequences)."
          }
        }
      }
    },

    "/api/can/{channel}/transmit/{transmit_id}": {
      "get": {
        "summary": "Get transmit sequence by ID",
        "description": "Returns a transmit sequence by ID.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "transmit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transmit sequence details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/transmit_sequence"
                }
              }
            }
          },
          "404": {
            "description": "Transmit sequence not found."
          }
        }
      },
      "delete": {
        "summary": "Delete transmit sequence",
        "description": "Deletes a transmit sequence by ID.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "transmit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transmit sequence deleted."
          },
          "404": {
            "description": "Transmit sequence not found."
          }
        }
      }
    },

    "/api/can/{channel}/transmit/{transmit_id}/count": {
      "get": {
        "summary": "Get transmit sequence count",
        "description": "Returns the current count value of the transmit sequence.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "transmit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current count value.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295,
                  "description": "Valid count range (0xFFFFFFFF is the error value).",
                  "example": 10
                }
              }
            }
          },
          "404": {
            "description": "Transmit sequence not found."
          }
        }
      },
      "put": {
        "summary": "Update transmit sequence count",
        "description": "Updates the count value of an existing transmit sequence.",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "transmit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967294,
                "description": "Valid count range (the 0xFFFFFFFF error value is excluded).",
                "example": 10
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transmit sequence count updated."
          },
          "400": {
            "description": "Bad request (invalid count value/format)."
          },
          "404": {
            "description": "Transmit sequence not found."
          }
        }
      }
    }
  },

  "components": {
    "schemas": {
      "time": {
        "type": "object",
        "properties": {
          "utc": {
            "type": "string",
            "format": "date-time",
            "description": "Device time as an RFC3339/ISO-8601 UTC timestamp string, format YYYY-MM-DDTHH:MM:SS.sssZ. Must be 2025-01-01T00:00:00.000Z or later."
          },
          "rate_ppb": {
            "type": "integer",
            "minimum": -200000,
            "maximum": 200000,
            "description": "Clock rate correction applied to the device time, in parts per billion. Positive when the device clock is being sped up, i.e. it would otherwise run slow. Use 0 when no correction is known."
          }
        },
        "required": ["utc", "rate_ppb"],
        "example": {
          "utc": "2025-01-01T00:00:00.000Z",
          "rate_ppb": 0
        }
      },

      "status": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["error_active", "error_warning", "error_passive", "bus_off", "stopped"],
            "description": "CAN controller state."
          },
          "frame_count": {
            "type": "integer",
            "description": "Frame counter."
          },
          "frame_rate": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame rate in frames per second."
          },
          "bus_load": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Bus load (0-100%)."
          },
          "rx_error_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128,
            "description": "Receive error counter."
          },
          "tx_error_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256,
            "description": "Transmit error counter."
          },
          "bus_error_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Bus error counter."
          }
        },
        "required": ["state", "frame_count", "frame_rate", "bus_load", "rx_error_count", "tx_error_count", "bus_error_count"],
        "example": {
          "state": "stopped",
          "frame_count": 0,
          "frame_rate": 0,
          "bus_load": 0,
          "rx_error_count": 0,
          "tx_error_count": 0,
          "bus_error_count": 0
        }
      },

      "bittiming": {
        "type": "object",
        "properties": {
          "brp": {
            "type": "integer",
            "minimum": 1,
            "description": "Baud Rate Prescaler."
          },
          "seg1": {
            "type": "integer",
            "minimum": 1,
            "description": "Phase Segment 1."
          },
          "seg2": {
            "type": "integer",
            "minimum": 1,
            "description": "Phase Segment 2."
          },
          "sjw": {
            "type": "integer",
            "minimum": 1,
            "description": "Synchronization Jump Width."
          }
        },
        "required": ["brp", "seg1", "seg2", "sjw"]
      },

      "phy": {
        "type": "object",
        "properties": {
          "listen_only": {
            "type": "boolean",
            "description": "Enables listen-only mode."
          },
          "auto_reset": {
            "type": "boolean",
            "description": "Enables automatic bus-off recovery."
          },
          "error_frames": {
            "type": "boolean",
            "description": "Enables monitoring of error frames (bus error, stuffing error, etc.)."
          },
          "tx_ack_frames": {
            "type": "boolean",
            "description": "Enables transmission acknowledgements. When enabled, an acknowledgement is sent to the client via the WebSocket for each successfully transmitted frame. Disabling reduces network data usage."
          },
          "timing": {
            "description": "Nominal bit timing.",
            "allOf": [
              {
                "$ref": "#/components/schemas/bittiming"
              }
            ]
          },
          "timing_data": {
            "description": "Data phase bit timing (for CAN-FD).",
            "allOf": [
              {
                "$ref": "#/components/schemas/bittiming"
              }
            ]
          }
        },
        "required": ["listen_only", "auto_reset", "error_frames", "tx_ack_frames", "timing", "timing_data"],
        "example": {
          "listen_only": false,
          "auto_reset": true,
          "error_frames": false,
          "tx_ack_frames": true,
          "timing": {
            "brp": 4,
            "seg1": 63,
            "seg2": 16,
            "sjw": 4
          },
          "timing_data": {
            "brp": 4,
            "seg1": 15,
            "seg2": 4,
            "sjw": 4
          }
        }
      },

      "filter": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 32,
            "description": "Optional user-defined label."
          },
          "is_extended": {
            "type": "boolean",
            "description": "True for an extended (29-bit) ID, false for a standard (11-bit) ID."
          },
          "is_range": {
            "type": "boolean",
            "description": "True if the filter is a range filter, false if it is a mask filter."
          },
          "f1": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "When is_range=false: filter ID. When is_range=true: range start."
          },
          "f2": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "When is_range=false: filter mask. When is_range=true: range end."
          }
        },
        "required": ["is_extended", "is_range", "f1", "f2"],
        "example": {
          "label": "Optional filter label",
          "is_extended": false,
          "is_range": false,
          "f1": 0,
          "f2": 0
        }
      },

      "frame": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 32,
            "description": "Optional user-defined label."
          },
          "is_extended": {
            "type": "boolean",
            "description": "True for an extended (29-bit) ID, false for a standard (11-bit) ID."
          },
          "is_fd": {
            "type": "boolean",
            "description": "True for a CAN FD frame, false for a classic CAN frame."
          },
          "is_rtr_brs": {
            "type": "boolean",
            "description": "RTR for classic CAN, BRS (Bit Rate Switch) for CAN-FD."
          },
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Frame identifier."
          },
          "data": {
            "type": "string",
            "description": "Hexadecimal encoded data payload. Empty string for no data bytes. For RTR frames, dummy bytes set the frame length.",
            "pattern": "^[0-9a-fA-F]*$",
            "maxLength": 128
          }
        },
        "required": ["is_extended", "is_fd", "is_rtr_brs", "id", "data"]
      },

      "transmit_sequence": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 32,
            "description": "Optional user-defined label."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967294,
            "description": "Maximum number of times to transmit the sequence."
          },
          "period_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "Period of the full sequence in milliseconds."
          },
          "spacing_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "Spacing between individual frames in the sequence in milliseconds."
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/frame"
            }
          }
        },
        "required": ["limit", "period_ms", "spacing_ms", "frames"],
        "example": {
          "label": "Optional transmit label",
          "limit": 10,
          "period_ms": 1000,
          "spacing_ms": 1,
          "frames": [
            {
              "label": "Optional frame label",
              "is_extended": false,
              "is_fd": false,
              "is_rtr_brs": false,
              "id": 1,
              "data": "01020304"
            }
          ]
        }
      }
    }
  }
}
